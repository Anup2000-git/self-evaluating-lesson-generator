# =====================================================================
# Self-Evaluating Lesson Generator - environment configuration
# Copy this file to .env and fill in the Azure values. Never commit .env.
# (Comments must be on their own lines.)
# =====================================================================

# --- Azure OpenAI (required) -----------------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
# A dated API version uses the classic Azure endpoint; "v1" uses the GA v1 API (/openai/v1/).
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Two deployments drive every role (libs/common/src/lessongen_common/llm/config.py):
#   primary (strong): planner, writer, judge tie-break, memory reflector
#   fast (cheaper):   LLM judges, judge confirmation, fact-checker, simulated learner
LLM_PRIMARY_DEPLOYMENT=gpt-5.5
LLM_FAST_DEPLOYMENT=gpt-5.4-mini

# Optional per-role overrides (tier, deployment, reasoning_effort, temperature, max_output_tokens):
# LLM_ROLES__FACT_CHECKER__TIER=primary
# LLM_ROLES__WRITER__REASONING_EFFORT=high
# LLM_ROLES__JUDGE__DEPLOYMENT=my-other-deployment

# Optional: an embeddings deployment switches the knowledge service to hybrid (BM25 + vector) search.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Use the Responses API instead of Chat Completions (only if your deployment requires it).
LLM_USE_RESPONSES_API=false
# Max concurrent LLM calls per service process (protects your Azure TPM quota).
LLM_MAX_CONCURRENCY=4
# Prices in USD per 1M tokens for cost tracking (defaults cover gpt-5.5, gpt-5.4-mini, gpt-4o):
# LLM_PRICING={"gpt-5.5": {"input": 5, "cached_input": 0.5, "output": 30}}

# --- Pipeline policy ---------------------------------------------------
# Retries after the first attempt (the assessment asks for 1-2 so the loop always ends).
MAX_RETRIES=2
# Hard cost cap per run in USD; once exceeded no further retries are started.
RUN_BUDGET_USD=5
# Language used for word hints in lessons.
HELPER_LANGUAGE=Hindi
# A FAIL from the first judge must be confirmed by a second vote (third vote breaks ties).
JUDGE_CONFIRM_FAILS=true

# --- Infrastructure ----------------------------------------------------
POSTGRES_USER=lessongen
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=lessongen
LOG_LEVEL=INFO
LOG_JSON=true

# --- Observability (optional) ------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lesson-generator
